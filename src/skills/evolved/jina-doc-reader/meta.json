{
  "id": "jina-doc-reader",
  "name": "技术文档安全抓取",
  "description": "只通过统一安全抓取器读取用户提供的公开文档地址；样例须评测并人工启用",
  "reviewStatus": "pending",
  "triggers": [
    "(官方文档|技术文档|api\\s*手册|开发指南)"
  ],
  "author": "autonomous-reflection",
  "confidence": 0.9,
  "executionPlan": {
    "pipeline": [
      {
        "action": "regex_extract",
        "params": {
          "pattern": "(https?://[^\\s<>]+)"
        },
        "exportAs": "extractedUrl"
      },
      {
        "action": "safe_fetch",
        "params": {
          "url": "{{$1}}"
        }
      }
    ]
  }
}
